{% extends "base.twig" %}
{% block content %}
	{% include 'home/text-wide.twig' with {data:home.rendez_vous} %}

	<section class="section">
		{% if post.title %}
			<h2 class="grand-titre">
				{{ post.title }}
			</h2>
		{% endif %}
		<p class="chapo">
			{{ post.description }}
		</p>
		<div>
			{{ post.content }}
		</div>

		<form id="contact">
			<fieldset>

				<div class="fields">
					<div>
						<label for="nom">Nom</label>
						<div><input data-autosave type="text" id="nom" required value=""></div>
					</div>
					<div>
						<label for="nom">Prénom</label>
						<div><input data-autosave type="text" id="prenom" required value=""></div>
					</div>
				</div>
				<div class="fields">
					<div>
						<label for="email">Adresse e-mail pro</label>
						<div><input data-autosave type="email" id="email_pro" value=""></div>
					</div>
					<div>
						<label for="email">Adresse e-mail</label>
						<div><input data-autosave type="email" id="email" required value=""></div>
					</div>
					<div>
						<label for="telephone">Numéro de téléphone</label>
						<div><input data-autosave type="text" id="telephone" required value=""></div>
					</div>
				</div>
				<div class="fields">
					<div>
						<label for="commune">Commune du projet</label>
						<div><input data-autosave type="text" id="commune" required value=""></div>
					</div>
					<div>
						<label for="objet">Objet de votre prise de contact</label>
						<div>
							<select data-autosave id="objet" required>
								<option disbaled selected hidden>Vous nous contactez pour ...</option>
								<option value="etude" {{get.objet=='etude' ? 'selected' : '' }}>Demander une étude personnalisée</option>
								<option value="question">Poser une question sur un autre sujet</option>
							</select>
						</div>
					</div>
				</div>
				<div class="fields">
					<div>
						<label for="connaissance">Comment nous avez-vous connu ?</label>
						<div>
							<select data-autosave id="connaissance" required>
								<option disabled selected hidden value="">Choisissez une réponse ...</option>
								<option value="recherche">Recherche internet</option>
								<option value="reseaux">Réseaux sociaux</option>
								<option value="bouche-a-oreille">Bouche à oreille</option>
								<option value="parrainage">Parrainage</option>
								<option value="autre">Autre</option>
							</select>
						</div>
					</div>
				</div>

				<div>
					<label for="message">Message</label>
					<div>
						<textarea data-autosave id="message" required rows="10"></textarea>
					</div>
				</div>

			</fieldset>


			<fieldset>
				<div>
					<label for="optin"><input type="checkbox" required id="optin">{{post.meta.mention_optin}}</label>
				</div>
				<div class="boutons">
					<button type="submit" class="bouton">Envoyer</button>
					<a href="/contact" class="bouton alt">Annuler</a>
				</div>
			</fieldset>
			<div>{{post.meta.texte_sous_le_formulaire}}</div>
		</form>
	</section>

	<style>
		.fields>div:has(#email_pro) {
			display: none !important;
		}
	</style>
{% endblock %}
