{% block html_head_container %}

{% include 'head.twig' %}
{% block head %}{% endblock %}
</head>{% endblock %}

<body class="{{ body_class }}" data-template="base.twig" data-articles="{{ posts_last_3.length > 0 ? 'true' : 'false'}}">
    {{ function('wp_body_open') }}

    {% include 'header.twig' %}
    {% if annonce.afficher_annonce %}
        <div id="annonce" style="--couleur-fond-annonce:{{annonce.couleur_fond_annonce}};--couleur-texte-annonce:{{annonce.couleur_texte_annonce}};">
            <div>
                <strong>{{annonce.titre_annonce}}</strong>
                {{annonce.texte_annonce}}
            </div>
        </div>
    {% endif %}
        {% block blockHero %}{% endblock %}

    <div class="container">

        {% block content %}{% endblock %}

    </div>
    {% include 'footer.twig' %}
    {{ function('wp_footer') }}
</body>

</html>